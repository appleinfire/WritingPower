rules_version = '2';
// Firestore security rules for family sync.
// Paste into Firebase console → Firestore Database → Rules → Publish.
service cloud.firestore {
  match /databases/{database}/documents {
    // A family is reachable only by its key, which the app derives from the family code + PIN.
    match /families/{fid} {
      allow get, create, update: if request.auth != null && fid.matches('^[a-f0-9]{64}$');
      allow list, delete: if false;   // nobody can list or delete families
      match /profiles/{pid} {
        allow read, write: if request.auth != null && fid.matches('^[a-f0-9]{64}$');
      }
    }
  }
}
